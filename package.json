{
  "name": "dsh-tencent-docs-toolbox",
  "version": "0.1.2",
  "type": "module",
  "description": "Tencent Docs toolbox for DSH with automatic sign-in, persistent sessions and live account limits.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-tencent-docs-toolbox.git"
  },
  "exports": {
    ".": "./lib/src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "runtime",
    "lib"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node scripts/check.mjs && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync-runtime": "node scripts/sync-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.65.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.19.0 <4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "tencent-docs",
    "toolbox",
    "transcription",
    "document-conversion"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
